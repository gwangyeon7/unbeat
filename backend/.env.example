LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# 트랙 카드 재생 버튼용. Google Cloud Console에서 프로젝트 생성 후 "YouTube Data API v3" 활성화 ->
# 사용자 인증 정보에서 API 키 발급 (OAuth 아님, API 키만 있으면 검색 가능). 무료 할당량: 하루 10,000 유닛
# (검색 1회=100유닛, 하루 약 100회) — 백엔드에서 결과를 14일 캐싱해서 최대한 아껴 씀.
YOUTUBE_API_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=unbeat
DB_PASSWORD=
DB_NAME=unbeat

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 가사 수동 등록(POST /lyrics/override) 접근용 비밀값. 로그인/권한 시스템이 없는 프로젝트라
# 최소한의 접근 제한으로 씀 — 아무 값이나 정해서 넣고, 호출할 때 X-Admin-Secret 헤더로 같은 값을 보내면 됨.
ADMIN_SECRET=

# "빠른 선곡" AI 추천(POST /quick-picks/ai)용. 이 프로젝트의 첫 유료 API 의존성 —
# https://console.anthropic.com 에서 계정 생성 후 API 키 발급. 호출당 약 $0.002~0.003
# (Claude Haiku 4.5 기준) 수준이라 세션+날짜 단위로 하루 한 번만 호출하도록 캐싱해뒀음.
# 값이 비어있으면 엔드포인트가 503을 반환하고, 프론트는 기존 아티스트 기반 추천으로 자동 폴백함.
ANTHROPIC_API_KEY=
